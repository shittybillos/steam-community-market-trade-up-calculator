{
  "manifest_version": 3,
  "name": "Steam Community Market Trade-up Calculator",
  "version": "0.7.0",
  "minimum_chrome_version": "111",
  "description": "Add individual Steam CS2 listings to an on-page trade-up calculator with locally decoded inspect floats.",
  "permissions": ["storage"],
  "background": {"service_worker": "background.js"},
  "content_scripts": [
    {"matches": ["https://steamcommunity.com/market/*"], "js": ["bridge.js"], "world": "MAIN", "run_at": "document_start"},
    {"matches": ["https://steamcommunity.com/market/*"], "js": ["content.js"], "run_at": "document_idle"}
  ],
  "web_accessible_resources": [{"resources": ["catalog.json"], "matches": ["https://steamcommunity.com/*"]}]
}
